  "motion": {
    "allowed": [
      {
        "element": "button",
        "property": "transform, box-shadow",
        "duration": "120ms",
        "easing": "standard",
        "trigger": "press"
      },
      {
        "element": "sectionCard, journeyNode",
        "property": "transform, box-shadow",
        "duration": "200ms",
        "easing": "standard",
        "trigger": "hover (pointer fine only)"
      },
      {
        "element": "quizOption (correct)",
        "property": "transform (one-shot hop, 1 iteration)",
        "duration": "400ms",
        "easing": "overshoot",
        "trigger": "answer"
      },
      {
        "element": "quizOption (incorrect)",
        "property": "transform (one-shot 4px side wobble, 1 iteration)",
        "duration": "300ms",
        "easing": "standard",
        "trigger": "answer"
      },
      {
        "element": "mascot",
        "property": "transform (one-shot hop, 1 iteration)",
        "duration": "900ms",
        "easing": "overshoot",
        "trigger": "correct answer, lesson complete"
      },
      {
        "element": "confetti layer",
        "property": "transform, opacity (one-shot particles, auto-removed)",
        "duration": "1200ms",
        "easing": "exit",
        "trigger": "quiz or lesson complete"
      },
      {
        "element": "journeyNode (unlock)",
        "property": "transform scale 0.8 to 1 (one-shot)",
        "duration": "400ms",
        "easing": "overshoot",
        "trigger": "load of newly unlocked node"
      },
      {
        "element": "page view",
        "property": "opacity, translateY 8px",
        "duration": "200ms",
        "easing": "standard",
        "trigger": "view-transition"
      },
      {
        "element": "spinner",
        "property": "rotate",
        "duration": "800ms linear",
        "easing": "linear",
        "trigger": "loading state only"
      },
      {
        "element": "dove (main page load)",
        "property": "transform, opacity (one-shot)",
        "duration": "600ms",
        "easing": "standard",
        "trigger": "load",
        "note": "Explicit exception to 'motion answers a tap or marks a win'. Never blocks input. Skipped on reduced motion and on slow devices."
      }
    ],
    "reducedMotion": "Under prefers-reduced-motion: reduce, every entry above becomes an instant state change. Hop, wobble, confetti and scale are replaced by a static star or check icon and a colour change. Spinner becomes a static hourglass icon. View transitions are disabled.",
