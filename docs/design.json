{
  "meta": {
    "name": "Kid Zone design system",
    "version": "0.3.0",
    "theme": "light",
    "styleDescriptors": [
      "storybook",
      "sticker-buttons",
      "rounded",
      "warm-cream-canvas",
      "journey-path-progress",
      "mascot-led",
      "liturgical-season-accents",
      "rainbow-sections",
      "orange-brand-standout"
    ],
    "provenance": {
      "note": "Values are project decisions unless a reference is named. Reference pages were fetched as text/metadata only (no screenshots or computed CSS), so reference styling is NOT measured.",
      "verifiedFromReferences": {
        "playmagicreef.com": {
          "themeColor": "#2a52d8",
          "structure": "plain hero heading on background, one primary CTA, 3-step 'how it works', use-case carousel 01/03, single closing CTA, simple footer"
        },
        "papumba.com": {
          "structure": "announcement bar > nav (Home, For Parents, For Teachers, About, News, primary CTA) > hero (title, trust line, stats) > product video on device frames > awards strip > 4 activity modes (Play, Explore, Listen, Read) as illustrated panels > parent/teacher resources > new-releases carousel > testimonials > download CTA > illustrated footer"
        }
      },
      "unverified": {
        "coddy.tech/journeys": "Page body is client-rendered and returned metadata only. 'Journey' pattern (ordered path of lesson nodes with progress) is taken from the URL and your description; exact styling is UNKNOWN.",
        "themagicalpantry.com": "Blocked automated access. No data. UNKNOWN."
      }
    },
    "confidence": {
      "tokens": "high (project-defined)",
      "referenceMatch": "low-medium (structure only)",
      "contrast": "computed, WCAG 2.x relative luminance"
    }
  },
