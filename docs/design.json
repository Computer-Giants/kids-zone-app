  "layout": {
    "grid": {
      "mobile": "4 columns, 16px gutter",
      "tablet": "8 columns, 24px gutter",
      "desktop": "12 columns, 32px gutter"
    },
    "containerWidths": {
      "content": "1120px",
      "reading": "680px",
      "quiz": "720px"
    },
    "breakpoints": {
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem",
      "note": "Tailwind v4 defaults; design mobile first"
    },
    "spacingRhythm": "4px base; vertical rhythm between page sections 64px mobile / 96px desktop; inside cards 24px",
    "patterns": ["stacked", "bento"],
    "pageFlow": {
      "reference": "papumba.com section order, adapted",
      "sections": [
        {
          "id": "top-bar",
          "maps": "announcement bar",
          "use": "Liturgical-season or feast-day note only. Dismissible. No promos, no countdowns."
        },
        {
          "id": "nav",
          "maps": "nav",
          "use": "Logo, Home, Bible, Saints, Fun, Chat, plus a parent-gate entry. Bottom tab bar on mobile."
        },
        {
          "id": "hero",
          "maps": "hero",
          "use": "Plain heading on background, one primary action, mascot illustration beside (desktop) or below (mobile). Verse of the Day sits directly under."
        },
        {
          "id": "modes",
          "maps": "Play / Explore / Listen / Read panels",
          "use": "Large illustrated section panels: Bible (blue), Saints and Catechism (yellow), Fun (quizzes red, games green, stories indigo), Chat (violet). Alternate image left/right on desktop; stacked on mobile."
        },
        {
          "id": "journey",
          "maps": "coddy journey",
          "use": "'Continue your journey': a path of lesson nodes with current, completed and locked states."
        },
        {
          "id": "new",
          "maps": "new releases carousel",
          "use": "Saint of the Day, new story, new quiz. Horizontal scroll-snap, no auto-advance."
        },
        {
          "id": "grown-ups",
          "maps": "for parents / for teachers",
          "use": "Parent and catechist entry. Visually neutral (slate) so kids read it as not-for-them."
        },
        {
          "id": "cta",
          "maps": "download / try free CTA",
          "use": "Single closing primary action."
        },
        {
          "id": "footer",
          "maps": "illustrated footer",
          "use": "Simple footer with a ground illustration strip. Parent-gated external links."
        }
      ],
      "dropped": [
        "testimonials wall",
        "awards strip",
        "store badges",
        "cookie ad-consent banner",
        "stats counters"
      ]
    }
  },
  "elementStyling": {
    "hero": {
      "title": "Plain typography (h1, heading family, ink) directly on the page background. No pill, chip, badge or card around it.",
      "background": "surface.page with 2 to 3 soft blob shapes (tint colours, no gradient, behind content, z-index below text)",
      "illustration": "mascot beside the title, never inside a container behind the text",
      "primaryAction": "one large sticker button below the title"
    },
    "navigation": {
      "mobile": {
        "type": "bottom tab bar",
        "height": "72px + safe-area-inset-bottom",
        "items": 4,
        "item": "icon 32px above label 14px/700, min target 64x56",
        "background": "surface.card",
        "topBorder": "2px border.default",
        "active": "icon and label use section deep colour; icon sits on a tint-colour circle 48px"
      },
      "desktop": {
        "type": "top bar",
        "height": "80px",
        "items": "logo, 4 section links as large text buttons, parent gate",
        "active": "section deep colour with 4px underline in section base"
      },
      "homeButton": "always visible, never hidden in a menu"
    },
    "cards": {
      "sectionCard": {
        "container": "background tint of the section, radius xl, padding 24px, border 2px border.default, shadow cardRest",
        "icon": "solid section deep colour on white circle 72px; no gradient",
        "label": "heading family 24px/600 ink inside the card is card content, not a page title",
        "aspect": "min-height 160px mobile, 220px desktop",
        "tap": "entire card is the target"
      },
      "contentCard": {
        "container": "surface.card, radius lg, padding 24px, border 2px border.default, shadow cardRest"
      },
      "verseCard": {
        "container": "surface.card with 4px left border in bible base; text in scripture font at scripture size, line-height 1.8; read-aloud button top-right of the card"
      },
      "journeyNode": {
        "size": "72px circle, 88px for current",
        "states": {
          "completed": "fill the lesson's section deep colour, white check icon",
          "current": "fill brand orange, ink icon, sticker shadow in orangeDeep, mascot standing beside",
          "locked": "fill slateTint, slate lock icon, no shadow"
        },
        "connector": "4px dashed line in border.default between nodes"
      }
    },
    "buttons": {
      "shape": "radius pill, heading family, weight 700",
      "sizes": {
        "md": {
          "height": "56px",
          "padX": "32px",
          "fontSize": "1.125rem"
        },
        "lg": {
          "height": "64px",
          "padX": "40px",
          "fontSize": "1.25rem"
        },
        "icon": {
          "size": "56px",
          "radius": "pill"
        }
      },
