{
  "name": "@kidzone/root",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\" --ignore-path .gitignore",
    "db:generate": "pnpm --filter @kidzone/db generate",
    "db:migrate": "pnpm --filter @kidzone/db migrate",
    "db:studio": "pnpm --filter @kidzone/db studio",
    "knip": "knip",
    "syncpack": "syncpack list-mismatches",
    "prepare": "husky || true"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "knip": {
    "workspaces": {
      ".": {},
      "apps/*": {},
      "packages/*": {}
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^21.2.3",
    "@kidzone/config": "workspace:*",
    "husky": "^9.1.7",
    "knip": "^5.40.0",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "syncpack": "^13.0.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
